    "@types/react-dom": "^19.0.0",
    "@types/tinycolor2": "^1.4.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^5.1.2",
