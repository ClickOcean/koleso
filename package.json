    "@mantine/notifications": "^9.2.2",
    "@tabler/icons-react": "^3.34.1",
    "@tanstack/react-pacer": "^0.17.3",
    "@tanstack/react-query": "^5.84.1",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.10",
    "dexie": "^4.2.1",
    "es-toolkit": "^1.42.0",
    "gsap": "3",
